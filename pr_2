library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity universal_shift_register is
    Port (
        CLK   : in  STD_LOGIC;
        RESET : in  STD_LOGIC;
        S1    : in  STD_LOGIC;
        S0    : in  STD_LOGIC;
        D     : in  STD_LOGIC_VECTOR(3 downto 0);
        SR    : in  STD_LOGIC;
        SL    : in  STD_LOGIC;
        Q     : out STD_LOGIC_VECTOR(3 downto 0)
    );
end universal_shift_register;

architecture Behavioral of universal_shift_register is

    signal temp : STD_LOGIC_VECTOR(3 downto 0);

begin

    process(CLK, RESET)
    begin
        if RESET = '1' then
            temp <= "0000";

        elsif rising_edge(CLK) then

            case S1 & S0 is

                when "00" =>
                    temp <= temp;

                when "01" =>
                    temp <= SR & temp(3 downto 1);

                when "10" =>
                    temp <= temp(2 downto 0) & SL;

                when "11" =>
                    temp <= D;

                when others =>
                    temp <= "0000";

            end case;
        end if;
    end process;

    Q <= temp;

end Behavioral;
